# 复制为 .env 后按需修改：cp .env.example .env
# Windows: copy .env.example .env

# ===== 后端 api 容器 =====
# api 容器内监听端口。注意这里【不是】用户访问的端口，
# 因为 docker-compose 里 api 没有映射 ports，外界到不了这个端口。
PORT=8000
# 容器内必须绑 0.0.0.0，nginx 才能通过服务名 api 连上；
# 本地开发不设这个变量时，server.js 默认绑 127.0.0.1（仅本机可见）。
HOST=0.0.0.0

# ===== 前端 nginx 容器 =====
# 唯一对外暴露的端口：http://localhost:8088
WEB_PORT=8088

# ===== 运行时参数 =====
# 会话有效期（天），对应 server.js 的 SESSION_DAYS
SESSION_DAYS=7
# 单文件上传上限（字节），对应 server.js 的 MAX_UPLOAD_BYTES，默认 20MB
MAX_UPLOAD_BYTES=20971520
